# Copy this file to .env (same folder) and fill in the values. Never commit .env.
# Every setting is explained in docs/ENVIRONMENT.md.

NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string; see docs/SETUP.md, step 1.
# Looks like: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/prajzo?retryWrites=true&w=majority
MONGODB_URI=

# Only needed if the API log says "querySrv ECONNREFUSED" (a known Node.js-on-Windows DNS
# problem). Public DNS servers used only to look up the mongodb+srv:// address.
# DNS_SERVERS=1.1.1.1,8.8.8.8

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

LOG_LEVEL=info

# Optional, with sensible defaults. See docs/ENVIRONMENT.md.
# AUTH_RATE_LIMIT_MAX=10        sign-in / sign-up / password-reset attempts per 15 minutes
# SESSION_TTL_DAYS=14           how long a customer stays signed in without visiting
# ADMIN_SESSION_TTL_HOURS=8     how long an administrator stays signed in without visiting
