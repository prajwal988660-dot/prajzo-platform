# Copy this file to .env (same folder) and fill in the values. Never commit .env.
# Every setting is explained in docs/ENVIRONMENT.md.

NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string; see docs/SETUP.md, step 1.
# Looks like: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/prajzo?retryWrites=true&w=majority
MONGODB_URI=

# Only needed if the API log says "querySrv ECONNREFUSED" (a known Node.js-on-Windows DNS
# problem). Public DNS servers used only to look up the mongodb+srv:// address.
# DNS_SERVERS=1.1.1.1,8.8.8.8

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

LOG_LEVEL=info

# Optional, with sensible defaults. See docs/ENVIRONMENT.md.
# AUTH_RATE_LIMIT_MAX=10        sign-in / sign-up / password-reset attempts per 15 minutes
# API_RATE_LIMIT_MAX=600        API requests of any kind per connection per minute
# ADMIN_RATE_LIMIT_MAX=1200     requests per administrator to the admin area per 15 minutes
# CLIENT_ERROR_RATE_LIMIT_MAX=20  browser error reports per connection per 15 minutes
# SESSION_TTL_DAYS=14           how long a customer stays signed in without visiting
# ADMIN_SESSION_TTL_HOURS=8     how long an administrator stays signed in without visiting
# SESSION_MAX_DAYS=60           the longest a customer's sign-in can last in total
# ADMIN_SESSION_MAX_HOURS=24    the longest an administrator's sign-in can last in total

# Staging only: with a password set, every page, file and API request asks for a user name and
# password. At least 12 characters. Leave both out on the live site. See docs/SETUP.md, section 6.
# STAGING_PASSWORD=
# STAGING_USER=preview

# Email (D-060). Default: printed to the log, not sent. To really send, run
# npm run mail:setup -w @prajzo/api (or double-click "Set up email.cmd"), which fills these in:
# MAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=contact@prajzo.com
# SMTP_PASSWORD=
