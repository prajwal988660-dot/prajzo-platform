{
  "name": "@prajzo/api",
  "version": "0.0.0",
  "private": true,
  "description": "Prajzo API (Express + MongoDB)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed.ts",
    "e2e:server": "tsx src/scripts/e2e-server.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@prajzo/shared": "*",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15"
  }
}
